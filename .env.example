# ============================================================================
# wiemeinsch.ch — Environment-Variablen-Template
#
# Kopieren nach `.env` und Werte LOKAL setzen. `.env` ist gitignored —
# niemals echte Werte committen (HABIT 1).
# Diese Datei wird pro Implementierungsphase ergänzt
# und muss immer den tatsächlichen Env-Bedarf der App spiegeln (HABIT 5).
# ============================================================================

# --- Docker Compose (Phase 1) ------------------------------------------------
# Aktives Compose-Profil: "dev" (täglich) — Prod-Modus via `--profile prod`.
COMPOSE_PROFILES=dev

# PostgreSQL (Compose-Service `db`; Host innerhalb der Container ist `db`, nicht localhost)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Von der App verwendete Verbindungs-URL (in Compose aus den POSTGRES_*-Werten gesetzt).
# Die DB hat bewusst kein Host-Port-Expose; Direktzugriff via `docker compose exec db psql`.
# DATABASE_URL=postgresql://<user>:<password>@db:5432/<db>

# --- Auth (Phase 4) ----------------------------------------------------------
# NextAuth v4: Basis-URL der App + Signatur-Secret (z.B. `openssl rand -base64 32`).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (leer lassen = Google-Login deaktiviert, nur Magic Link).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP für Magic-Link-Mails. Dev: Mailpit (Compose, Host `mailpit`, Port 1025,
# ohne Auth). Prod: Infomaniak-SMTP (Entscheid E5).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=login@wiemeinsch.local

# Cloudflare Turnstile (Entscheid E6). Dev: offizielle, dokumentierte Dummy-Keys
# (Sitekey "1x…AA" = sichtbar+bestehen; Secret "1x…AA" = siteverify immer ok,
# "2x…AA" = siteverify immer fail — für Negativtests).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Client-IP nur hinter Cloudflare aus Proxy-Headern lesen (Prod: true, lokal: false).
TRUST_PROXY=false

# --- AI-Services: Civic-Linter & Übersetzung (Phase 6) -----------------------
# Mistral-API-Key. Auch lokal ein echter Schlüssel (Unit-Tests mocken die
# API, die App nicht) — ein Dev-Key mit eigenem Budget wird empfohlen. In
# Produktion ein Key auf einem BEZAHLTEN Plan: Nur dort trainiert Mistral
# nicht mit den Texten, was die Datenschutzerklärung zusagt.
MISTRAL_API_KEY=

# Modell-IDs — NUR hier konfiguriert, nie im Code.
# Stand 29.08.2026 (docs.mistral.ai): Moderation 2 = mistral-moderation-2603,
# Medium 3.5 = mistral-medium-2604.
MISTRAL_MODERATION_MODEL=mistral-moderation-2603
MISTRAL_LINTER_MODEL=mistral-medium-2604
MISTRAL_TRANSLATE_MODEL=mistral-medium-2604

# Optional: Pause vor dem einen Retry bei 429/5xx in Millisekunden (Standard
# 1000, plus Zufall; ein `Retry-After` der API hat Vorrang). Die Unit-Tests
# setzen 0.
# MISTRAL_RETRY_DELAY_MS=1000
# --- Periodische Aufgaben (Phase 15) -----------------------------------------
# Schlüssel für den internen Cron-Endpunkt POST /api/cron/recompute
# (Score-Recompute, Entscheid E9, und Löschen abgelaufener Rate-Limit-
# Zähler, Anmelde-Links und Sessions — Fristen der Datenschutzerklärung). LEER = Endpunkt ist deaktiviert und
# antwortet 404 — lokal der Normalfall, weil der Recompute hier über
# `npm run scores:recompute` läuft. In der Zielumgebung ein langer
# Zufallswert (z.B. `openssl rand -base64 32`), gesetzt in der App-Umgebung
# UND im Scheduler.
CRON_SECRET=

# --- Backup (Phase 15) -------------------------------------------------------
# Diese Variablen liest NICHT der App-Container, sondern der PostgreSQL-Node
# der Zielumgebung bzw. der Arbeitsplatz beim Restore-Test
# (scripts/backup/*.sh). Sie stehen hier
# nur der Vollständigkeit halber und bleiben lokal auskommentiert.
# BACKUP_AGE_RECIPIENT=      # öffentlicher age-Schlüssel (age1...), kein Secret
# BACKUP_AGE_IDENTITY=       # Pfad zur privaten age-Identität — NUR beim Restore
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=         # Node: write-only (nur PutObject)
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# Nur für scripts/backup/rotate.sh am Arbeitsplatz, mit EIGENEN Zugangsdaten
# (List + Delete) — und nur, wenn der Bucket keine Lifecycle-Regel kann.
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=12
